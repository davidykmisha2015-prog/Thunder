main {
    note_file = "notes.txt"
    running = true

    while running == true {
        box(42, 5, 2, 2, "cyan", "THUNDER NOTEBOOK", "center")
        printt("1 - Переглянути нотатку", "yellow")
        printt("2 - Створити нотатку", "yellow")
        printt("3 - Вийти", "yellow")

        printl("Виберіть дію: ", choice)

        if choice == 1 {
            content = read_file(note_file)
            printt("Поточна нотатка:", "green", "bold")
            printt(content)
        } else if choice == 2 {
            printl("Введіть текст нотатки: ", new_note)
            write_file(note_file, new_note)
            printt("Нотатку збережено.", "green", "bold")
        } else if choice == 3 {
            running = false
            printt("До побачення!", "cyan")
        } else {
            printt("Невідома дія.", "red")
        }
    }
}
